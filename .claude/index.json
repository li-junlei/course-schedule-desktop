      "test_coverage": "部分单元测试 (parser.rs, crypto.rs)",
      "documentation": "src-tauri/CLAUDE.md",
      "coverage_estimate": "100%"
    }
  ],
  "data_models": {
    "Course": {
      "fields": [
        "name: string - 课程名称",
        "teacher: string - 教师名称",
        "weeks: number[] - 周次列表",
        "week_type: number - 单双周标记",
        "day_of_week: number - 星期 (1-7)",
        "periods: number[] - 节次范围",
        "location: string - 地点"
      ],
      "locations": [
        "src/types.ts",
        "src-tauri/src/models.rs"
      ]
    },
    "AppConfig": {
      "fields": [
        "background_image?: string - 背景图片",
        "first_day?: number - 学期第一天时间戳",
        "end_week?: number - 结束周次",
        "max_periods?: number - 最大节次",
        "period_times?: string[] - 节次时间表"
      ],
      "locations": [
        "src/types.ts",
        "src-tauri/src/models.rs"
      ]
    }
