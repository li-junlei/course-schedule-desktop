          "open_login_window - 打开登录窗口",
          "clear_all_data - 清空所有数据"
        ]
      },
      "dependencies": [
        "tauri",
        "reqwest",
        "scraper",
        "serde",
        "md5",
        "des",
        "chrono",
        "dirs"
